{
	"name": "webext-storage",
	"version": "3.1.0",
	"description": "A more usable typed storage API for Web Extensions",
	"license": "MIT",
	"repository": "fregante/webext-storage",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		"types": "./distribution/index.d.ts",
		"default": "./distribution/index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"prepack": "tsc --sourceMap false",
		"test": "tsc && xo && tsd --typings distribution/index.d.ts && node --test",
		"test:watch": "node --test --watch",
		"watch": "tsc --watch"
	},
	"files": [
		"distribution"
	],
	"keywords": [
		"browser",
		"extension",
		"chrome",
		"firefox",
		"safari",
		"webextension",
		"storage",
		"session",
		"sync",
		"local",
		"event",
		"web-ext"
	],
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.5",
		"tsd": "^0.33.0",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"tsd": {
		"directory": "source"
	}
}
